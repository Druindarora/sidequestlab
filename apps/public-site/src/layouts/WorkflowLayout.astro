---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'workflows'>;
  workflows: CollectionEntry<'workflows'>[];
}

const { entry, workflows } = Astro.props;
const currentPath = Astro.url.pathname;
const workflowGroups = Array.from(
  workflows.reduce((groups, workflow) => {
    const versions = groups.get(workflow.data.workflowId) ?? [];
    versions.push(workflow);
    groups.set(workflow.data.workflowId, versions);
    return groups;
  }, new Map<string, CollectionEntry<'workflows'>[]>()),
)
  .map(([, versions]) => versions.sort((a, b) => a.data.version.localeCompare(b.data.version)))
  .sort((a, b) => a[0].data.order - b[0].data.order);

const workflowHref = (workflow: CollectionEntry<'workflows'>) =>
  `/portfolio/workflows/${workflow.data.workflowSlug}/${workflow.data.version}`;
const publishedDate = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' }).format(entry.data.publishedAt);
---

<BaseLayout title={`${entry.data.title} — ${entry.data.version} — Imagine Code & Build`} description={entry.data.summary}>
  <div class="page page--wide workflow-page">
    <details class="workflow-navigation-mobile">
      <summary>Navigation des workflows</summary>
      <nav aria-label="Navigation des workflows">
        <ul class="workflow-navigation__list">
          {
            workflowGroups.map((versions) => (
              <li>
                {versions.length === 1 ? (
                  <a
                    class:list={{ 'workflow-navigation__link': true, 'is-active': workflowHref(versions[0]) === currentPath }}
                    href={workflowHref(versions[0])}
                    aria-current={workflowHref(versions[0]) === currentPath ? 'page' : undefined}
                  >
                    {versions[0].data.navTitle}
                  </a>
                ) : (
                  <>
                    <p class="workflow-navigation__group-title">{versions[0].data.navTitle}</p>
                    <ul class="workflow-navigation__versions" aria-label={`Versions de ${versions[0].data.navTitle}`}>
                      {versions.map((workflow) => (
                        <li>
                          <a
                            class:list={{ 'workflow-navigation__link': true, 'is-active': workflowHref(workflow) === currentPath }}
                            href={workflowHref(workflow)}
                            aria-current={workflowHref(workflow) === currentPath ? 'page' : undefined}
                          >
                            {workflow.data.version.toUpperCase()}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <div class="workflow-layout">
      <aside class="workflow-navigation">
        <p class="workflow-navigation__label">Workflows &amp; automatisations</p>
        <nav aria-label="Navigation des workflows">
          <ul class="workflow-navigation__list">
            {
              workflowGroups.map((versions) => (
                <li>
                  {versions.length === 1 ? (
                    <a
                      class:list={{ 'workflow-navigation__link': true, 'is-active': workflowHref(versions[0]) === currentPath }}
                      href={workflowHref(versions[0])}
                      aria-current={workflowHref(versions[0]) === currentPath ? 'page' : undefined}
                    >
                      {versions[0].data.navTitle}
                    </a>
                  ) : (
                    <>
                      <p class="workflow-navigation__group-title">{versions[0].data.navTitle}</p>
                      <ul class="workflow-navigation__versions" aria-label={`Versions de ${versions[0].data.navTitle}`}>
                        {versions.map((workflow) => (
                          <li>
                            <a
                              class:list={{ 'workflow-navigation__link': true, 'is-active': workflowHref(workflow) === currentPath }}
                              href={workflowHref(workflow)}
                              aria-current={workflowHref(workflow) === currentPath ? 'page' : undefined}
                            >
                              {workflow.data.version.toUpperCase()}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <article class="workflow-article">
        <header class="workflow-page__header">
          <p class="hero__kicker">Workflow &amp; automatisation</p>
          <div class="title-row">
            <h1>{entry.data.title}</h1>
            <span class="status">{entry.data.version.toUpperCase()}</span>
          </div>
          <p class="workflow-page__summary">{entry.data.summary}</p>
          <p class="workflow-page__meta">Publié le {publishedDate}</p>
        </header>
        <slot />
      </article>
    </div>
  </div>

  <dialog class="workflow-lightbox" aria-labelledby="workflow-lightbox-title">
    <div class="workflow-lightbox__toolbar">
      <p id="workflow-lightbox-title" class="workflow-lightbox__title"></p>
      <button class="workflow-lightbox__close" type="button" aria-label="Fermer l’aperçu">×</button>
    </div>
    <button class="workflow-lightbox__navigation" type="button" data-lightbox-previous aria-label="Image précédente">‹</button>
    <img class="workflow-lightbox__image" alt="" />
    <button class="workflow-lightbox__navigation" type="button" data-lightbox-next aria-label="Image suivante">›</button>
  </dialog>
</BaseLayout>

<script>
  const article = document.querySelector<HTMLElement>('.workflow-article');
  const lightbox = document.querySelector<HTMLDialogElement>('.workflow-lightbox');

  if (article && lightbox) {
    const images = Array.from(article.querySelectorAll<HTMLImageElement>('img'));
    const enlargedImage = lightbox.querySelector<HTMLImageElement>('.workflow-lightbox__image');
    const title = lightbox.querySelector<HTMLElement>('.workflow-lightbox__title');
    const closeButton = lightbox.querySelector<HTMLButtonElement>('.workflow-lightbox__close');
    const previousButton = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-previous]');
    const nextButton = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    let activeIndex = 0;
    let triggerImage: HTMLImageElement | undefined;

    const showImage = (index: number) => {
      activeIndex = (index + images.length) % images.length;
      const image = images[activeIndex];

      if (enlargedImage) {
        enlargedImage.src = image.currentSrc || image.src;
        enlargedImage.alt = image.alt;
      }

      if (title) {
        title.textContent = image.alt || 'Aperçu de l’image';
      }
    };

    const closeLightbox = () => lightbox.close();

    images.forEach((image, index) => {
      image.classList.add('workflow-article__image');
      image.tabIndex = 0;
      image.setAttribute('role', 'button');
      image.setAttribute('aria-label', `Agrandir l’image${image.alt ? ` : ${image.alt}` : ''}`);

      const openLightbox = (event: Event) => {
        event.preventDefault();
        triggerImage = image;
        showImage(index);
        lightbox.showModal();
        document.body.classList.add('lightbox-open');
        closeButton?.focus();
      };

      image.addEventListener('click', openLightbox);
      image.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openLightbox(event);
        }
      });
    });

    if (images.length > 1) {
      previousButton?.addEventListener('click', () => showImage(activeIndex - 1));
      nextButton?.addEventListener('click', () => showImage(activeIndex + 1));
    } else {
      if (previousButton) previousButton.hidden = true;
      if (nextButton) nextButton.hidden = true;
    }

    closeButton?.addEventListener('click', closeLightbox);

    lightbox.addEventListener('click', (event) => {
      const target = event.target;

      if (target instanceof Element && target !== enlargedImage && !target.closest('button')) {
        closeLightbox();
      }
    });

    lightbox.addEventListener('keydown', (event) => {
      if (images.length < 2) return;

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showImage(activeIndex - 1);
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();
        showImage(activeIndex + 1);
      }
    });

    lightbox.addEventListener('close', () => {
      document.body.classList.remove('lightbox-open');
      triggerImage?.focus();
      triggerImage = undefined;
    });
  }
</script>
