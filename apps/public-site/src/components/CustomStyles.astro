---
import '@fontsource-variable/inter';
---

<style is:inline>
  :root {
    color-scheme: light;

    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(79 70 229);
    --aw-color-secondary: rgb(67 56 202);
    --aw-color-accent: rgb(79 70 229);

    --aw-color-text-heading: rgb(15 23 42);
    --aw-color-text-default: rgb(24 24 27);
    --aw-color-text-muted: rgb(82 82 91);
    --aw-color-bg-page: rgb(248 250 252);

    ::selection {
      background-color: rgb(224 231 255);
      color: rgb(49 46 129);
    }
  }
</style>
