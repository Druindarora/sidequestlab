---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Portfolio — Imagine Code & Build"
  description="Projets Angular / Java de Stéphane (Imagine Code & Build) : SideQuestLab, MémoQuiz, et 11 ans d'expérience en mission bancaire et industrielle."
>
  <main class="page">
    <section class="page-header portfolio-header section">
      <p class="hero__kicker">Imagine Code &amp; Build</p>
      <h1>Portfolio</h1>
      <p class="page-header__subtitle">
        Une sélection de projets qui illustrent ma façon de construire : full-stack Angular / Java
      </p>
    </section>

    <section class="section portfolio-projects" aria-label="Projets publics">
      <div class="portfolio-grid">
        <article class="card portfolio-card">
          <h2>SideQuestLab</h2>
          <p class="tag">Angular · Java / Spring Boot · PostgreSQL</p>
          <p>
            monorepo &amp; labo public — Angular, Java/Spring Boot, PostgreSQL. Architecture
            front/back claire, API et UI cohérentes, base V1 solide.
          </p>
          <div class="actions">
            <Button
              variant="secondary"
              href="https://github.com/Druindarora/sidequestlab"
              target="_blank"
              text="Voir le repo SideQuestLab"
            />
          </div>
        </article>

        <article class="card portfolio-card">
          <h2>MémoQuiz</h2>
          <p class="tag">Angular · Java / Spring Boot · PostgreSQL</p>
          <p>
            Méthode de Leitner (répétition espacée). Gestion des cartes, sessions de révision,
            historique et tableau de bord.
          </p>
          <div class="actions">
            <Button variant="secondary" href="/demo-memoquiz" text="Voir la démo" />
          </div>
        </article>
      </div>
    </section>

    <section class="section portfolio-proof" aria-label="Expérience professionnelle">
      <p>
        Mes projets personnels illustrent ma méthode. Mon expérience professionnelle (BPCE,
        Partecis, Sodifrance — 11 ans, environnements bancaires et industriels à forte volumétrie)
        est détaillée sur la page Profil &amp; CV.
      </p>
      <div class="actions">
        <Button variant="secondary" href="/profil" text="Voir mon expérience professionnelle" />
      </div>
    </section>

    <p class="portfolio-github">
      <a href="https://github.com/Druindarora" target="_blank" rel="noopener noreferrer">
        Voir mon profil GitHub
      </a>
    </p>

    <section class="home-contact" aria-label="Contact">
      <p>Ces projets illustrent ma méthode de travail. Pour une mission Java/Angular, discutons-en.</p>
      <Button
        variant="primary"
        href="mailto:contact@imaginecodebuild.dev"
        text="Me contacter pour une mission"
      />
    </section>
  </main>
</BaseLayout>
