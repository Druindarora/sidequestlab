---
import BaseLayout from '../layouts/BaseLayout.astro';

const screenshots = [
  { src: '/memoquiz/dashboard.png', caption: 'Dashboard du jour' },
  { src: '/memoquiz/session.png', caption: 'Session de revision' },
  { src: '/memoquiz/cards.png', caption: 'Gestion des cartes' },
  { src: '/memoquiz/quiz.png', caption: 'Admin quiz (default)' },
];
---

<BaseLayout
  title="Démo MémoQuiz | SideQuestLab"
  description="Aperçu en captures d’écran de l’application MémoQuiz."
>
  <main class="page page--wide">
    <section class="page-header section">
      <div class="title-row">
        <h1>Démo MémoQuiz</h1>
        <span class="status">Aperçu</span>
      </div>
      <p class="page-header__subtitle">MemoQuiz = app de révision Leitner, module SideQuestLab.</p>
      <aside class="info-banner" aria-label="Statut de la démo">
        <strong>Prévisualisation non jouable</strong>
        <p>
          Cette page présente des captures d’écran de l’interface, en attendant une démo
          interactive.
        </p>
      </aside>
    </section>

    <section class="section">
      <h2>Ce que vous voyez ici</h2>
      <ul>
        <li>Dashboard du jour pour visualiser les cartes à revoir et la progression.</li>
        <li>Session de révision avec parcours question/réponse et auto-évaluation.</li>
        <li>Gestion des cartes pour créer, modifier et maintenir le contenu.</li>
        <li>Admin quiz pour piloter le quiz par défaut et ses options de base.</li>
      </ul>
    </section>

    <section class="section" aria-label="Galerie MemoQuiz">
      <p class="note">Cliquez sur une capture pour l’agrandir dans un nouvel onglet.</p>
      <div class="gallery">
        {
          screenshots.map(({ src, caption }) => (
            <figure>
              <a href={src} target="_blank" rel="noopener noreferrer" aria-label={`Ouvrir la capture : ${caption}`}>
                <img src={src} alt={caption} loading="lazy" />
              </a>
              <figcaption>{caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="actions">
      <a class="button button--outline" href="/portfolio">Retour au portfolio</a>
      <a
        href="https://github.com/Druindarora/sidequestlab"
        target="_blank"
        rel="noopener noreferrer">Voir le code (SideQuestLab)</a
      >
    </section>
  </main>
</BaseLayout>
