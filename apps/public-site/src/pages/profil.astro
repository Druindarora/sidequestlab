---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';

const experiences = [
  {
    company: 'Partecis (via Timtek)',
    dates: 'Mai 2023 — Avril 2025',
    description:
      'Application de gestion des terminaux de paiement (TPE) pour BPCE et BNP Paribas. Recruté pour la compétence front Angular manquante. Migrations Angular/Spring Boot, réécriture du front, référent technique.',
    stack: 'Java, Spring Boot, Angular, Oracle SQL, Hibernate',
  },
  {
    company: 'BPCE (via Timtek)',
    dates: 'Novembre 2020 — Avril 2023',
    description:
      "Application de signature électronique pour prêts PME (~10 000 à 15 000 demandes/mois). Deux migrations majeures Angular, reprise d'une librairie interne critique, formation de plusieurs équipes.",
    stack: 'Java, Spring Boot, Angular, MySQL',
  },
  {
    company: 'Sodifrance',
    dates: '2018 — 2020',
    description:
      'Plateforme B2B pour installateurs de cuisines professionnelles. Première spécialisation Angular (migration v5 → v8), stabilisation par débogage approfondi.',
    stack: 'Java, Angular, JPA, SQL',
  },
  {
    company: 'SBT',
    dates: '2014 — 2017',
    description:
      'Plateforme web de gestion pour un réseau de boutiques (Cartier), 4 applications livrées.',
    stack: 'PHP, JavaScript, MySQL',
  },
];
---

<BaseLayout
  title="Profil & CV — Imagine Code & Build"
  description="CV de Stéphane, développeur full-stack Java / Angular senior (11 ans) — BPCE, Partecis, Sodifrance. Disponible pour une mission longue, Imagine Code & Build."
>
  <div class="page">
    <section class="page-header profile-header section">
      <p class="hero__kicker">Imagine Code &amp; Build</p>
      <h1>Profil &amp; CV</h1>
      <p class="page-header__subtitle">
        Développeur full-stack Angular / Java, orienté UX et productivité (outils IA)
      </p>
      <div class="actions">
        <Button
          variant="secondary"
          href="/CV_stephane_boivin.pdf"
          target="_blank"
          text="Voir mon CV (PDF)"
        />
        <Button
          variant="primary"
          href="mailto:contact@imaginecodebuild.dev"
          text="Me contacter pour une mission"
          class="profile-header__primary"
        />
      </div>
    </section>

    <section class="section profile-summary" id="resume">
      <h2>Résumé de profil</h2>
      <p>
        Développeur full-stack senior (11 ans d'expérience), spécialisé Java / Spring Boot et
        Angular, avec une dominante front Angular affirmée sur mes dernières missions : migrations
        de versions, refonte de code existant, rôle de référent technique.
      </p>
      <p>
        J'interviens sur des environnements existants (bancaire, industriel) pour reprendre,
        moderniser et fiabiliser des applications métier, avec une approche pragmatique : cadrage
        clair, code propre, tests, montées de version maîtrisées.
      </p>
      <p>
        Depuis 2025, j'intègre l'IA comme un véritable levier d'industrialisation dans mes pratiques
        de développement : cadrage de specs courtes, génération guidée, automatisation de workflows
        (Claude Code, Codex, n8n, GitHub Actions) — en complément de mon expertise Java/Angular, pas
        en remplacement.
      </p>
    </section>

    <section class="section profile-experiences" id="experience">
      <h2>Expériences</h2>
      <div class="experience-list">
        {
          experiences.map((experience) => (
            <article class="experience">
              <div class="experience__header">
                <h3>{experience.company}</h3>
                <p class="experience__dates">{experience.dates}</p>
              </div>
              <p>{experience.description}</p>
              <p class="experience__stack">{experience.stack}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section profile-project" id="projet-personnel">
      <h2>Projet personnel</h2>
      <p>
        En parallèle, je développe MémoQuiz au sein de SideQuestLab, mon labo public — une
        application de révision basée sur la méthode de Leitner, terrain d'application de mes
        workflows de développement outillés par l'IA.
      </p>
      <div class="actions">
        <Button variant="secondary" href="/portfolio" text="Voir le projet" />
      </div>
    </section>

    <section class="section profile-skills" id="skills">
      <h2>Compétences techniques</h2>
      <div class="grid">
        <article class="card">
          <h3>Front-end</h3>
          <ul>
            <li>Angular</li>
            <li>TypeScript, JavaScript</li>
            <li>HTML5, CSS3 / SCSS</li>
            <li>RxJS</li>
            <li>Conception de composants réutilisables</li>
            <li>Intégration responsive</li>
          </ul>
        </article>
        <article class="card">
          <h3>Back-end</h3>
          <ul>
            <li>Java (dont Java 21 sur les projets récents)</li>
            <li>Spring Boot (API REST, Spring Data, sécurité)</li>
            <li>Conception et consommation d’API REST</li>
            <li>Bases de données relationnelles (PostgreSQL, SQL)</li>
          </ul>
        </article>
        <article class="card">
          <h3>Outils &amp; pratiques</h3>
          <ul>
            <li>Git, GitHub / GitLab</li>
            <li>Docker (environnements de dev / containers)</li>
            <li>Tests (JUnit, tests front de base, approche pragmatique)</li>
            <li>CI et checks automatisés (niveau projet)</li>
            <li>Documentation et structuration de projet</li>
            <li>Outils IA (assistance à l’analyse, rédaction, génération guidée)</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="home-contact" aria-label="Contact">
      <p>Ce profil correspond à votre besoin ? Discutons de votre mission.</p>
      <Button variant="primary" href="mailto:contact@imaginecodebuild.dev" text="Me contacter" />
    </section>
  </div>
</BaseLayout>
